<Window
    x:Class="WindowsSpaces.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Spaces Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the window extends its content into it, so this row is
             the title bar. Everything but the reserved caption-button area
             drags the window. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32"
              Background="{ThemeResource LayerOnAcrylicFillColorDefault}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="CaptionButtonsInset" Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="AppTitleIcon" Width="16" Height="16"/>
                <TextBlock Text="Windows Spaces" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Independent workspaces for every monitor" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Navigation & Content Area -->
        <NavigationView x:Name="MainNavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged"
                        OpenPaneLength="200">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Workspaces" Tag="Workspaces">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shortcuts" Tag="Shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="App Rules" Tag="Rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sync &amp; Options" Tag="Sync">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Hidden until Debug mode is switched on in Sync &amp; Options -->
                <NavigationViewItem x:Name="DiagnosticsNavItem" Content="Diagnostics" Tag="Diagnostics" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="24,16,24,16">
                <!-- ================= WORKSPACES SECTION ================= -->
                <ScrollViewer x:Name="WorkspacesSection" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Stretch" Margin="0,0,14,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Monitor Workspaces" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Set up the spaces on each connected monitor. Every monitor switches independently."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- List of Monitors -->
                        <ItemsControl x:Name="MonitorsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,12">
                                        <StackPanel Spacing="12">
                                            <!-- Monitor Header -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <!-- Editable display name; empty falls back to the device name shown in the badge -->
                                                    <TextBox Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="{Binding DefaultDisplayName}"
                                                             ToolTipService.ToolTip="Rename this display"
                                                             FontWeight="SemiBold" FontSize="16"
                                                             MinWidth="200" MaxLength="40"
                                                             VerticalAlignment="Center"/>
                                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                            Visibility="{Binding HasCustomName}">
                                                        <TextBlock Text="{Binding DefaultDisplayName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="1" Tag="{Binding MonitorId}" Click="OnAddWorkspaceClicked" Style="{ThemeResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                        <TextBlock Text="Add Space"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Workspaces list for this monitor -->
                                            <ItemsControl ItemsSource="{Binding Workspaces}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="12,8"
                                                                Margin="0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Space index badge -->
                                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Index}" Foreground="White" FontWeight="Bold"
                                                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Editable Space Name -->
                                                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"
                                                                         PlaceholderText="Workspace Name"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,12,0"
                                                                         TextChanged="OnWorkspaceNameChanged"/>

                                                                <!-- Delete workspace button -->
                                                                <Button Grid.Column="2" Tag="{Binding}" Click="OnDeleteWorkspaceClicked"
                                                                        ToolTipService.ToolTip="Delete workspace"
                                                                        Background="Transparent" BorderThickness="0">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= SHORTCUTS SECTION ================= -->
                <ScrollViewer x:Name="ShortcutsSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Stretch" Margin="0,0,14,0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Keyboard Shortcuts" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Configure key combinations to instantly switch workspaces or move windows on the active monitor."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnResetShortcutsClicked" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="12"/>
                                    <TextBlock Text="Reset to Defaults"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Shortcuts List -->
                        <ItemsControl x:Name="ShortcutsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="12">
                                            <!-- Main Summary Row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <FontIcon Grid.Column="0" Glyph="{Binding CategoryGlyph}" FontSize="18"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          Margin="0,0,12,0" VerticalAlignment="Center"/>

                                                <!-- Title and Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <!-- Conflict warning if any -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                                Visibility="{Binding HasConflict, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                        <TextBlock Text="{Binding ConflictMessage}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Shortcut Badge Pills -->
                                                <Border Grid.Column="2" Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="12,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedDisplay}" FontWeight="Bold" FontSize="13"
                                                               FontFamily="Cascadia Code, Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </Border>

                                                <!-- Edit toggle button -->
                                                <ToggleButton Grid.Column="3" IsChecked="{Binding IsEditing, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Padding="8,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                        <TextBlock Text="Edit"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- Expanded Editor Controls -->
                                            <Border Visibility="{Binding IsEditing, Mode=OneWay}"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="16,12"
                                                    Margin="0,4,0,0">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Select Modifiers and Key:" FontWeight="SemiBold" FontSize="12"/>
                                                    <StackPanel Spacing="12">
                                                        <!-- Modifiers Checkboxes -->
                                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                                            <CheckBox Content="Ctrl" MinWidth="0" IsChecked="{Binding IsCtrl, Mode=TwoWay}"/>
                                                            <CheckBox Content="Shift" MinWidth="0" IsChecked="{Binding IsShift, Mode=TwoWay}"/>
                                                            <CheckBox Content="Alt" MinWidth="0" IsChecked="{Binding IsAlt, Mode=TwoWay}"/>
                                                            <CheckBox Content="Win" MinWidth="0" IsChecked="{Binding IsWin, Mode=TwoWay}"/>
                                                        </StackPanel>

                                                        <!-- Key Selector ComboBox -->
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock Text="Key:" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            <ComboBox MinWidth="220"
                                                                      ItemsSource="{Binding AvailableKeys}"
                                                                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="None"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= RULES SECTION ================= -->
                <ScrollViewer x:Name="RulesSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Stretch" Margin="0,0,14,0">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Application Rules" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Automatically route applications to designated monitors and workspaces when launched."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnAddRuleClicked" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="Add Rule"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="RulesEmptyText" TextWrapping="Wrap"
                                   Text="No rules yet. Add one to send an app to a specific display and space whenever it opens."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <ItemsControl x:Name="RulesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="10">
                                            <!-- Name + delete -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding RuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Rule name" FontWeight="SemiBold"/>
                                                <Button Grid.Column="1" Tag="{Binding Id}" Click="OnDeleteRuleClicked"
                                                        ToolTipService.ToolTip="Delete rule"
                                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                </Button>
                                            </Grid>

                                            <!-- Which app -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding ProcessPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Header="Application"
                                                         PlaceholderText="App file name, e.g. chrome.exe — or pick one"/>
                                                <Button Grid.Column="1" Content="Running apps…" Tag="{Binding}"
                                                        Click="OnPickRunningAppClicked" VerticalAlignment="Bottom"/>
                                                <Button Grid.Column="2" Content="Browse…" Tag="{Binding}"
                                                        Click="OnBrowseForAppClicked" VerticalAlignment="Bottom"/>
                                            </Grid>

                                            <!-- Where it goes -->
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <ComboBox Header="Send to display" MinWidth="200"
                                                          ItemsSource="{Binding MonitorChoices}"
                                                          DisplayMemberPath="MonitorDisplayName"
                                                          SelectedValuePath="MonitorId"
                                                          SelectedValue="{Binding TargetMonitorId, Mode=TwoWay}"/>
                                                <ComboBox Header="Space" MinWidth="100"
                                                          ItemsSource="{Binding SpaceChoices}"
                                                          SelectedItem="{Binding SelectedSpace, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <!-- Optional extra matching -->
                                            <Expander Header="Match more precisely (optional)" HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                                <StackPanel Spacing="8">
                                                    <TextBox Text="{Binding WindowTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Header="Window title contains"
                                                             PlaceholderText="Leave empty to match any title"/>
                                                    <TextBox Text="{Binding WindowClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Header="Window class"
                                                             PlaceholderText="Leave empty to match any class"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= PROFILES SECTION ================= -->
                <ScrollViewer x:Name="ProfilesSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Stretch" Margin="0,0,14,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Workspace Profiles" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="A profile remembers which space is showing on each monitor. Activate it to switch every monitor back to that layout at once."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Save current layout card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Save the spaces showing right now" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="NewProfileNameInput" Width="260" PlaceholderText="e.g. Coding Setup, Gaming, Meeting"/>
                                    <Button Content="Save Profile" Click="OnSaveCurrentProfileClicked" Style="{ThemeResource AccentButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Profiles List -->
                        <TextBlock x:Name="ProfilesEmptyText" TextWrapping="Wrap"
                                   Text="No saved profiles. Arrange your spaces, then save the layout above to come back to it in one click."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <ItemsControl x:Name="ProfilesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Workspace configuration snapshot" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="Activate" Tag="{Binding Name}" Click="OnActivateProfileClicked"/>
                                                <Button Tag="{Binding Name}" Click="OnDeleteProfileClicked" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= SYNC & OPTIONS SECTION ================= -->
                <ScrollViewer x:Name="SyncSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Stretch" Margin="0,0,14,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sync &amp; Preferences" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage configuration storage location and visual preferences."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Sync Folder Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Cloud Configuration Sync" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Point config at a folder synced by OneDrive, Dropbox, Google Drive, or Nextcloud to share settings across multiple computers."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>

                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8">
                                    <TextBlock x:Name="SyncFolderText" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Code, Consolas" FontSize="12"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChooseSyncFolderButton" Click="OnChooseSyncFolderClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                                            <TextBlock Text="Choose Folder..."/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UseDefaultLocationButton" Content="Use Default Location" Click="OnUseDefaultLocationClicked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Startup Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Launch Windows Spaces automatically when you sign in."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="StartWithWindowsToggle" VerticalAlignment="Center" Margin="0" OffContent="" OnContent=""/>
                            </Grid>
                        </Border>

                        <!-- Transitions Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Smooth Transitions" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Enable smooth visual animations when switching between workspaces."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="EnableTransitionsToggle" IsOn="True" VerticalAlignment="Center" Margin="0" OffContent="" OnContent=""/>
                            </Grid>
                        </Border>

                        <!-- Keep windows rendered Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Keep Windows Rendered" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Park windows off-screen instead of hiding them, so they stay painted and switching is instant. Parked windows still appear in the taskbar and Alt+Tab."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="KeepRenderedToggle" IsOn="True" VerticalAlignment="Center" Margin="0" OffContent="" OnContent=""/>
                            </Grid>
                        </Border>

                        <!-- Open Settings on startup Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Open Settings on startup" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Show this window when Windows Spaces starts. Turn off to start quietly in the system tray."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="ShowSettingsOnStartupToggle" IsOn="True" VerticalAlignment="Center" Margin="0" OffContent="" OnContent=""/>
                            </Grid>
                        </Border>

                        <!-- Debug mode Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Debug mode" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Adds a Diagnostics page (live spaces and tracked windows) here and in the tray menu. Meant for troubleshooting."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="DebugModeToggle" IsOn="False" VerticalAlignment="Center" Margin="0" OffContent="" OnContent=""/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= DIAGNOSTICS SECTION ================= -->
                <ScrollViewer x:Name="DiagnosticsSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Stretch" Margin="0,0,14,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Diagnostics &amp; Inspector" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Inspect active workspaces and tracked window handles in real-time."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Live Active Workspaces" FontWeight="SemiBold"/>
                                <ListView x:Name="DiagMonitorsList" Height="140" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Tracked Windows" FontWeight="SemiBold"/>
                                <ListView x:Name="DiagWindowsList" Height="220" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Bottom Action Bar & Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Error / Status InfoBar -->
                <InfoBar x:Name="StatusInfoBar" Grid.Column="0" IsOpen="False" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedHintText" Text="Saved" Visibility="Collapsed" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <Button x:Name="CloseButton" Content="Close" Style="{ThemeResource AccentButtonStyle}" Click="OnCloseClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
