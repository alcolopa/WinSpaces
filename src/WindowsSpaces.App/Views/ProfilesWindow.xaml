<Window
    x:Class="WindowsSpaces.App.Views.ProfilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ProfileNameInput" Width="200" PlaceholderText="Profile Name"/>
            <Button x:Name="SaveCurrentButton" Content="Save Current Layout" Click="OnSaveCurrentClicked"/>
        </StackPanel>

        <ListView x:Name="ProfilesList" Grid.Row="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock x:Name="ErrorText" Foreground="Red" VerticalAlignment="Center"/>
            <Button x:Name="SaveButton" Content="Save" Click="OnSaveClicked"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Window>
