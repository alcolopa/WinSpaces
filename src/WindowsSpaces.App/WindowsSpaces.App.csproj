<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WindowsSpaces.App</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- WindowsAppSDKSelfContained needs a concrete RID, not just the
         RuntimeIdentifiers list, or the SelfContained targets fail with
         "WindowsAppSDKSelfContained requires a supported Windows architecture." -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- What Task Manager shows: its Name column uses the file description
         (AssemblyTitle), not the exe name. -->
    <AssemblyTitle>WinSpaces</AssemblyTitle>
    <Product>WinSpaces</Product>
    <Company>WinSpaces</Company>
    <Description>WinSpaces</Description>
    <!-- Release builds override this with -p:Version=<tag> (see release.yml);
         the update checker compares it against the latest GitHub release. -->
    <Version>0.0.2-beta</Version>
    <!-- Keep Program.Main as the entry point; without this the XAML compiler
         generates its own Main and the build fails with CS0017. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged WinUI3 apps look for a resource index file literally named
         resources.pri next to the exe (not <ProjectName>.pri, which is what
         the build produces by default). Without this the app crashes on
         launch inside Microsoft.UI.Xaml.dll before any of our code runs. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- .NET SDK 10 no longer ships the in-box MSIX/PRI MSBuild tooling
         (Microsoft\VisualStudio\v*\AppxPackage), which MrtCore.PriGen.targets
         requires. This package supplies it. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsSpaces.Core\WindowsSpaces.Core.csproj" />
    <ProjectReference Include="..\WindowsSpaces.Platform\WindowsSpaces.Platform.csproj" />
    <ProjectReference Include="..\WindowsSpaces.Persistence\WindowsSpaces.Persistence.csproj" />
  </ItemGroup>

  <!-- `dotnet publish` does not pick up the PRI index or the compiled XAML
       (.xbf) that the build puts next to the exe, so a published/installed
       app crashed with XamlParseException the first time any window opened.
       Add them to the publish set explicitly. -->
  <Target Name="IncludeXamlResourcesInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlPublishFile Include="$(OutDir)resources.pri;$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_XamlPublishFile)">
        <RelativePath>$([MSBuild]::MakeRelative('$(OutDir)', '%(_XamlPublishFile.FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
